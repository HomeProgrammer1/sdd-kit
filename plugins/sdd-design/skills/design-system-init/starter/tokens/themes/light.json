{
  "$description": "Semantic tokens: the names screens, code and Figma use. A theme only re-points aliases.",
  "color": {
    "background":  { "$type": "color", "$value": "{palette.neutral.50}" },
    "surface":     { "$type": "color", "$value": "{palette.neutral.0}" },
    "surface-2":   { "$type": "color", "$value": "{palette.neutral.100}" },
    "text":        { "$type": "color", "$value": "{palette.neutral.900}" },
    "text-muted":  { "$type": "color", "$value": "{palette.neutral.600}" },
    "border":      { "$type": "color", "$value": "{palette.neutral.200}" },
    "primary":     { "$type": "color", "$value": "{palette.brand.600}" },
    "on-primary":  { "$type": "color", "$value": "{palette.neutral.0}" },
    "primary-subtle": { "$type": "color", "$value": "{palette.brand.50}" },
    "danger":      { "$type": "color", "$value": "{palette.red.600}" },
    "danger-subtle":  { "$type": "color", "$value": "{palette.red.50}" },
    "success":     { "$type": "color", "$value": "{palette.green.700}" },
    "success-subtle": { "$type": "color", "$value": "{palette.green.50}" },
    "warning":     { "$type": "color", "$value": "{palette.amber.800}" },
    "warning-subtle": { "$type": "color", "$value": "{palette.amber.50}" },
    "info":        { "$type": "color", "$value": "{palette.blue.700}" },
    "info-subtle": { "$type": "color", "$value": "{palette.blue.50}" }
  },
  "space": {
    "1": { "$value": "{scale.space.1}" }, "2": { "$value": "{scale.space.2}" }, "3": { "$value": "{scale.space.3}" },
    "4": { "$value": "{scale.space.4}" }, "5": { "$value": "{scale.space.5}" }, "6": { "$value": "{scale.space.6}" },
    "8": { "$value": "{scale.space.8}" }, "10": { "$value": "{scale.space.10}" }, "12": { "$value": "{scale.space.12}" }
  },
  "radius": {
    "sm": { "$value": "{scale.radius.sm}" }, "md": { "$value": "{scale.radius.md}" },
    "lg": { "$value": "{scale.radius.lg}" }, "full": { "$value": "{scale.radius.full}" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "caption": { "$type": "dimension", "$value": 12 }, "label": { "$type": "dimension", "$value": 14 },
      "body": { "$type": "dimension", "$value": 16 }, "heading": { "$type": "dimension", "$value": 20 },
      "title": { "$type": "dimension", "$value": 28 }, "display": { "$type": "dimension", "$value": 40 }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 }, "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "diagram": {
    "paper":  { "$type": "color", "$value": "{palette.neutral.50}" },
    "ink":    { "$type": "color", "$value": "{palette.neutral.900}" },
    "accent": { "$type": "color", "$value": "{palette.brand.600}" },
    "accentTint": { "$type": "color", "$value": "{palette.brand.50}" }
  }
}
